{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DayNest: server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "DayNest: browser (start server first)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
